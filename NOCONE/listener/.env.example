# ---------------------------------------------------------
# IPs inventadas para prueba. Cámbialas por las reales.
# ---------------------------------------------------------
TMONE_SERVER_IP=192.168.100.10

# Listener web monitor
HTTP_HOST=0.0.0.0
HTTP_PORT=8090

# Listener unificado de ingestion
TCP_HOST=0.0.0.0
TCP_PORT=7070

# Backend dentro de docker-compose
BACKEND_BASE_URL=http://zenit-backend:8000/api

LOG_LEVEL=INFO
TZ=America/Santiago

# ---------------------------------------------------------
# GAO / Impinj R700-R720 RFID reader
# ---------------------------------------------------------
# Pedido: GAO activo por defecto.

# Uno o varios readers separados por coma.
# Ejemplo: GAO_READER_HOSTS=192.168.100.50,192.168.100.51

# Credenciales del reader. En firmware típico: root / impinj.
GAO_READER_USERNAME=root

# API HTTP/HTTPS del reader. En muchos readers HTTP viene habilitado primero.
GAO_READER_HTTPS=false
GAO_READER_VERIFY_TLS=false
GAO_EVENT_STREAM_ENABLED=false

# Si true, el listener intenta iniciar inventario al conectar.
# Déjalo false si el reader queda leyendo/configurado desde la interfaz web.
GAO_AUTO_START_INVENTORY=false
GAO_INVENTORY_PRESET=default

GAO_RECONNECT_SECONDS=5
GAO_STREAM_TIMEOUT_SECONDS=90
