@startuml
' ============================
' ZENIT - Diagrama de Casos de Uso
' ============================
left to right direction
skinparam packageStyle rectangle

actor "Operador\nCentro Control" as Operador
actor "Jefe de Turno" as JefeTurno
actor "Mantenimiento /\nIngeniería" as Mant
actor "Administrador\nSistema" as Admin
actor "Sistemas Externos\n(Corporativo/Mina)" as ExtSys

package "Plataforma ZENIT" {

  usecase "UC01 - Iniciar sesión\ncon credenciales" as UC01
  usecase "UC02 - Ver tablero general\n(KPIs, alarmas)" as UC02
  usecase "UC03 - Monitorear mapa\nen tiempo real" as UC03
  usecase "UC04 - Ver detalle de\nUR / gateway / sensor" as UC04
  usecase "UC05 - Monitorear pórticos\ny flujo de acceso" as UC05
  usecase "UC06 - Supervisar variables\nclimáticas en pórticos" as UC06
  usecase "UC07 - Consultar historial\nde accesos / trazas" as UC07
  usecase "UC08 - Gestionar personas\n(colaboradores / contratistas)" as UC08
  usecase "UC09 - Gestionar vehículos\n(asignaciones, niveles)" as UC09
  usecase "UC10 - Gestionar empresas\n(contractoras / mandantes)" as UC10
  usecase "UC11 - Gestionar equipos\ncríticos" as UC11
  usecase "UC12 - Configurar mapa\n(puntos, polígonos, zonas)" as UC12
  usecase "UC13 - Configurar pórticos\ny matrices de acceso" as UC13
  usecase "UC14 - Visualizar cámaras y\nmodelos IA asociados" as UC14
  usecase "UC15 - Exportar reportes\n(Excel / CSV / PDF)" as UC15
  usecase "UC16 - Administrar usuarios,\nroles y permisos" as UC16
  usecase "UC17 - Consultar API REST\npara KPIs / reportes" as UC17
  usecase "UC18 - Configuración técnica\n(parámetros de sistema)" as UC18
}

' Relaciones actores - casos de uso
Operador --> UC01
Operador --> UC02
Operador --> UC03
Operador --> UC04
Operador --> UC05
Operador --> UC06
Operador --> UC07
Operador --> UC12
Operador --> UC14
Operador --> UC15

JefeTurno --> UC01
JefeTurno --> UC02
JefeTurno --> UC03
JefeTurno --> UC05
JefeTurno --> UC06
JefeTurno --> UC07
JefeTurno --> UC11
JefeTurno --> UC15

Mant --> UC01
Mant --> UC04
Mant --> UC08
Mant --> UC09
Mant --> UC10
Mant --> UC11
Mant --> UC12
Mant --> UC13
Mant --> UC14
Mant --> UC18

Admin --> UC01
Admin --> UC16
Admin --> UC18

ExtSys --> UC17
UC02 <-- UC17 : <<include>>
UC07 <-- UC17 : <<include>>
UC15 <-- UC17 : <<include>>

@enduml
