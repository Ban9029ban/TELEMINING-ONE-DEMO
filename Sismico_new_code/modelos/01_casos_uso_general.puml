@startuml
left to right direction
skinparam packageStyle rectangle

actor "Operador" as Operador
actor "Administrador" as Admin
actor "Sistema remoto\nde sensado" as Sensado
actor "PLC / Script Python\nipsemaforo accion" as PLC
actor "Pantalla remota\n(browser)" as Pantalla
actor "Usuario IA" as UsuarioIA

rectangle "Dashboard Sísmico New" {
  usecase "Iniciar sesión" as UC_Login
  usecase "Visualizar estado sísmico\npor proyecto" as UC_View
  usecase "Consultar detalle\nde polígonos" as UC_Poligonos
  usecase "Sincronizar datos\nremotos" as UC_Poll
  usecase "Generar alerta" as UC_Alert
  usecase "Activar semáforos\nviales" as UC_Semaforos
  usecase "Monitorear pantallas\nactivas" as UC_Heartbeat
  usecase "Ver productividad" as UC_Productividad
  usecase "Consultar agente IA" as UC_IA
  usecase "Administrar sitios, mapas,\npantallas y reglas" as UC_Admin
  usecase "Cambiar tema\ny layout" as UC_Theme
}

Operador --> UC_Login
Operador --> UC_View
Operador --> UC_Poligonos
Operador --> UC_Alert
Operador --> UC_Productividad
Operador --> UC_Theme

Admin --> UC_Login
Admin --> UC_Admin
Admin --> UC_Heartbeat
Admin --> UC_Productividad

UsuarioIA --> UC_IA
Sensado --> UC_Poll
Pantalla --> UC_Heartbeat
PLC --> UC_Semaforos

UC_Alert .> UC_Semaforos : <<include>>
UC_View .> UC_Poll : <<include>>
UC_IA .> UC_View : <<uses>>
@enduml
