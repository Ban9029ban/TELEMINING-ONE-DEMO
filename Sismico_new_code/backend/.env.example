APP_NAME=Dashboard Sísmico API
APP_VERSION=2.5.0
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
POSTGRES_USER=admin
POSTGRES_DB=dashboard_sismico
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Agrega aqui la URL LAN exacta del frontend si el sistema se consulta desde otro equipo.
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173,http://localhost:15173,http://127.0.0.1:15173,http://192.168.100.238:15173,http://devtm.denial.cl:15173,http://stagtm.denial.cl:15173,http://10.18.43.147:15173
EXTERNAL_FETCH_TIMEOUT=8
EXTERNAL_FETCH_RETRIES=2
POLLING_SECONDS_DEFAULT=15
SOURCE_OFFLINE_THRESHOLD_SECONDS=90
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
PLC_RELAY_ROLE=disabled
PLC_RELAY_TARGET_URL=
PLC_RELAY_TIMEOUT_SECONDS=8
PLC_SCRIPT_PATH=/app/tools/plcctl.py
PLC_PYTHON_BIN=python
PLC_DEFAULT_TYPE=delta
PLC_DEFAULT_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
PUBLIC_API_BASE_URL=http://localhost:18000
SEMAFORO_EMULATOR_URL=http://semaforo_emulator_api:8000/api/emulator/semaforo/state
